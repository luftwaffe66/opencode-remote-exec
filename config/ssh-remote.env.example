# ssh-remote.env — multi-server config (PRIVATE TEMPLATE)
#
# 1. Copy to ~/.config/opencode/ssh-remote.env  (outside any repo, chmod 600):
#      cp config/ssh-remote.env.example ~/.config/opencode/ssh-remote.env
#      chmod 600 ~/.config/opencode/ssh-remote.env
# 2. Fill YOUR data. It hot-reloads on every call (no app restart to switch).
# 3. NEVER commit this file. NEVER put passwords in it (use key auth).
#
# Optional override for tests: SSH_REMOTE_ENV_FILE=/path/to/file

# Default server when tools omit server="name".
SSH_DEFAULT_SERVER=casa

# Comma list is documentary; servers are discovered via SSH_<NAME>_HOST.
SSH_SERVERS=casa,fuera

# --- casa (LAN) ---
SSH_CASA_HOST=192.168.100.6
SSH_CASA_PORT=22
SSH_CASA_USER=server
SSH_CASA_WORKSPACE=/home/server
SSH_CASA_KEY_PATH=~/.ssh/id_ed25519
SSH_CASA_CONNECT_TIMEOUT=5

# --- fuera (Tailscale / second box). Leave blank values = server disabled
#     until you fill them; unknown/empty hosts are rejected, never guessed.
SSH_FUERA_HOST=
SSH_FUERA_PORT=22
SSH_FUERA_USER=server
SSH_FUERA_WORKSPACE=/home/server
SSH_FUERA_KEY_PATH=~/.ssh/id_ed25519

# Command timeout (seconds) for every call. Killed + reported after this.
SSH_COMMAND_TIMEOUT=120
